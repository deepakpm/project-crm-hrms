# App runtime connects as the restricted role so RLS actually applies.
# Port 5433 (not 5432): avoids clashing with any other local Postgres container.
DATABASE_URL=postgresql+psycopg://ledgerly_app:ledgerly_app_dev_password@localhost:5433/ledgerly

# Alembic runs as the postgres bootstrap role (needs CREATE TABLE etc).
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/ledgerly

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-48-byte-secret
